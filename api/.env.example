# Sans DATABASE_URL, l'API démarre sur PGlite (PostgreSQL en mémoire) avec les données de démo.
# DATABASE_URL=postgres://mutualisation:mutualisation@localhost:5432/mutualisation
# SEED=1            # remplit une base PostgreSQL vide avec les données de démo
PORT=3000
CORS_ORIGIN=http://localhost:4200

# Connexion OpenID Connect (Keycloak, avec itsme en fournisseur d'identité).
# Sans OIDC_ISSUER, l'API accepte la connexion de démo (`Bearer <identifiant>`) ; refusé en production.
# OIDC_ISSUER=http://localhost:8080/realms/mutualisation
# OIDC_AUDIENCE=mutualisation-api
# Clés publiques ; par défaut <issuer>/protocol/openid-connect/certs (Keycloak).
# OIDC_JWKS_URL=
# Alias Keycloak du fournisseur qui vérifie l'identité.
# OIDC_VERIFIED_IDP=itsme

# Géocodage des adresses (Nominatim / OpenStreetMap). `GEOCODER=none` pour le désactiver.
# Le service public exige une identification (nom de l'application et contact) et limite à
# 1 requête par seconde ; pour du trafic réel, utiliser une instance hébergée.
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# GEOCODER_USER_AGENT=mutualisation/1.0 (contact@exemple.be)

# Photos : disque local (`uploads/`) par défaut, ou stockage objet compatible S3 en production.
# PHOTO_STORAGE=s3
# S3_BUCKET=mutualisation-photos
# S3_REGION=fr-par
# S3_ENDPOINT=https://s3.fr-par.scw.cloud
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# PHOTO_PUBLIC_URL=https://mutualisation-photos.s3.fr-par.scw.cloud
