# Sans DATABASE_URL, l'API démarre sur PGlite (PostgreSQL en mémoire) avec les données de démo.
# DATABASE_URL=postgres://mutualisation:mutualisation@localhost:5432/mutualisation
# SEED=1            # remplit une base PostgreSQL vide avec les données de démo
PORT=3000
CORS_ORIGIN=http://localhost:4200

# Connexion OpenID Connect (Keycloak, avec itsme en fournisseur d'identité).
# Sans OIDC_ISSUER, l'API accepte la connexion de démo (`Bearer <identifiant>`) ; refusé en production.
# OIDC_ISSUER=http://localhost:8080/realms/mutualisation
# OIDC_AUDIENCE=mutualisation-api
# Clés publiques ; par défaut <issuer>/protocol/openid-connect/certs (Keycloak).
# OIDC_JWKS_URL=
# Alias Keycloak du fournisseur qui vérifie l'identité.
# OIDC_VERIFIED_IDP=itsme
